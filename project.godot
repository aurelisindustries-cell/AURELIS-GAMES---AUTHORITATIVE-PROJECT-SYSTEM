;   param=value ; assign values to parameters

config_version=5

[application]

config/name="SYNthesis"
run/main_scene="uid://cpewl261a20xp"
config/features=PackedStringArray("4.7")
config/icon="res://icon.svg"

[autoload]

CutscenePreviewRunner="*uid://j3bmdd1ed67k"
Cuts="*res://addons/CutsceneSystem/cuts.gd"
GlobalGUI="*res://GameComponents/UI/global_gui.tscn"
SFX="*res://GameComponents/Audio/sfx_manager.tscn"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="viewport"

[editor_plugins]

enabled=PackedStringArray("res://addons/CutsceneSystem/plugin.cfg", "res://addons/at-icons/plugin.cfg", "res://addons/hitbox_authoring/plugin.cfg")

